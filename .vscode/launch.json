
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run: localhost:3000 + backend:5000",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "preLaunchTask": "Start Full Stack (Backend + Frontend)",
      "webRoot": "${workspaceFolder}/frontend",
      "runtimeArgs": ["--disable-extensions"]
    },
    {
      "name": "Desktop: MiraverseOSx",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/MiraverseOSx.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Backend: API Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:backend",
      "program": "${workspaceFolder}/bin/Debug/net8.0/MiraverseOSx.dll",
      "args": ["--server-only", "--port", "5000"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    }
  ]
}
