        "name": "UX_Characters_Name",
        "sql": "CREATE UNIQUE INDEX UX_Characters_Name ON Characters(lower(trim(Name)))"
      },
      {
        "name": "UniqueCharacterMAID",
        "sql": "CREATE UNIQUE INDEX UniqueCharacterMAID\r\nON Characters (UPPER(TRIM(Maid)))\r\nWHERE Maid IS NOT NULL\r\nAND TRIM(Maid) != ''"
      },
