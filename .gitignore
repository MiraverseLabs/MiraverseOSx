bin/
obj/

# Python bytecode caches
__pycache__/
*.py[cod]

# Local component previews and isolated browser test output
frontend/storybook-static/
frontend/playwright-report/
frontend/test-results/
output/vite-compatibility/

# Disposable local previews, build snapshots, and verification logs
/.codex-preview-build/
/output/*-build/
/output/character-audit/build-*/
/output/*.log
/output/character-audit/*.log
/tmp/pdfs/*-review.png

# Tool caches
**/.vite/
**/.cache/
*.tsbuildinfo
MiraverseOSx/

# On-demand external reference checkouts are kept outside application source.
/external/sources/

# Generated frontend build output. `vite build` writes here (outDir '../wwwroot')
# and empties it first, so it is reproducible with `npm run build:frontend`.
/wwwroot/

# Simulation runtime and test output
/.venv/
/simulation/**/__pycache__/
/simulation/output/
/simulation/state/

# Databases are runtime state, not source. Take a deliberate checkpoint with
# `npm run db:checkpoint`, which writes a vacuumed copy under backups/db/.
/miraverse.db
/miraverse.db-*
/miraverse.db.*
*.db.bak

# Local backup and migration checkpoint folders written by project scripts
/backups/

# Archived conversation exports and one-off research dumps
/2026-11-25/

# Design sources; master copies are kept outside the repository
*.psd
*.psb
*.ai

# Local build log
build.log
.dyad/
