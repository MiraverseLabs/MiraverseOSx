node_modules/
**/node_modules/
.pnp
.pnp.js

# testing
/coverage

# production / build outputs
/build
/dist
**/build/
**/dist/

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

